// ═══════════════════════════════════════════════════════════════════
// Stock Intel — Short-Term Scanner Indicator ⚡
// Versi PineScript untuk TradingView
// Menampilkan: Entry Zone, TP/SL, VWAP, Support/Resistance, Score
// ═══════════════════════════════════════════════════════════════════
//@version=5
indicator("Stock Intel Scanner ⚡", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── INPUT SETTINGS ──────────────────────────────────────────────
grp_sr    = "Support & Resistance"
sr_period = input.int(20, "S/R Lookback Period", minval=5, maxval=100, group=grp_sr)

grp_vwap  = "VWAP"
show_vwap = input.bool(true, "Show VWAP", group=grp_vwap)

grp_entry = "Entry Zone & Targets"
show_entry = input.bool(true, "Show Entry Zone", group=grp_entry)
show_tp_sl = input.bool(true, "Show TP / SL Lines", group=grp_entry)
atr_mult_tp = input.float(1.5, "ATR Multiplier for TP", minval=0.5, maxval=5.0, step=0.1, group=grp_entry)
atr_mult_sl = input.float(1.5, "ATR Multiplier for SL", minval=0.5, maxval=5.0, step=0.1, group=grp_entry)

grp_mom   = "Momentum"
ema_fast  = input.int(9, "EMA Fast", minval=2, maxval=50, group=grp_mom)
ema_mid   = input.int(20, "EMA Mid", minval=5, maxval=100, group=grp_mom)
ema_slow  = input.int(50, "EMA Slow", minval=10, maxval=200, group=grp_mom)

grp_vol   = "Volume Analysis"
vol_avg_period = input.int(20, "Volume Average Period", minval=5, maxval=100, group=grp_vol)
rvol_spike = input.float(2.0, "RVOL Spike Threshold", minval=1.0, maxval=10.0, step=0.1, group=grp_vol)

// ─── CALCULATIONS ────────────────────────────────────────────────
// EMAs
ema9  = ta.ema(close, ema_fast)
ema20 = ta.ema(close, ema_mid)
ema50 = ta.ema(close, ema_slow)

// ATR
atr14 = ta.atr(14)

// RSI
rsi14 = ta.rsi(close, 14)

// MACD
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

// ADX
[diPlus, diMinus, adxValue] = ta.dmi(14, 14)

// ROC
roc10 = ta.roc(close, 10)

// Stochastic
stochK = ta.stoch(close, high, low, 14)
stochD = ta.sma(stochK, 3)

// VWAP
vwapVal = ta.vwap(hlc3)

// Support & Resistance
resistance = ta.highest(high, sr_period)
support    = ta.lowest(low, sr_period)

// Volume
vol_avg = ta.sma(volume, vol_avg_period)
rvol    = vol_avg > 0 ? volume / vol_avg : 1.0

// ─── MOMENTUM ASSESSMENT ─────────────────────────────────────────
bullish_count = 0
bullish_count += (rsi14 > 50 and rsi14 < 75) ? 1 : 0
bullish_count += (macdLine > signalLine) ? 1 : 0
bullish_count += (close > ema9) ? 1 : 0
bullish_count += (close > ema20) ? 1 : 0
bullish_count += (ema20 > ema50) ? 1 : 0
bullish_count += (roc10 > 0) ? 1 : 0

mom_strength = bullish_count >= 5 ? "STRONG" : bullish_count >= 3 ? "MODERATE" : "WEAK"
trend_dir    = close > ema20 and ema20 > ema50 ? "UP" : close < ema20 and ema20 < ema50 ? "DOWN" : "SIDEWAYS"

// ─── ENTRY ZONE ──────────────────────────────────────────────────
entry_low  = math.max(support, close - atr14 * 0.5)
entry_high = close

// ─── TAKE PROFIT ─────────────────────────────────────────────────
tp1 = resistance > close ? resistance : close + atr14 * atr_mult_tp
tp2 = ta.highest(high, 10) > tp1 ? ta.highest(high, 10) : tp1 + atr14

// ─── STOP LOSS ───────────────────────────────────────────────────
sl_support = support - atr14 * 0.3
sl_atr     = close - atr14 * atr_mult_sl
sl_price   = math.max(sl_support, sl_atr)
sl_price   := sl_price >= close ? close - atr14 * atr_mult_sl : sl_price

// ─── RISK / REWARD ───────────────────────────────────────────────
pot_profit = tp1 - close
pot_loss   = close - sl_price
rr_ratio   = pot_loss > 0 ? pot_profit / pot_loss : 0

// ─── PLOTTING ────────────────────────────────────────────────────
// EMAs
plot(ema9, "EMA 9", color=color.new(color.yellow, 30), linewidth=1)
plot(ema20, "EMA 20", color=color.new(color.orange, 30), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.red, 30), linewidth=2)

// VWAP
plot(show_vwap ? vwapVal : na, "VWAP", color=color.new(color.purple, 20), linewidth=2, style=plot.style_stepline)

// Support & Resistance
plot(support, "Support", color=color.new(color.green, 40), linewidth=1, style=plot.style_stepline)
plot(resistance, "Resistance", color=color.new(color.red, 40), linewidth=1, style=plot.style_stepline)

// Entry Zone (filled area)
p_entry_lo = plot(show_entry ? entry_low : na, "Entry Low", color=color.new(color.teal, 80))
p_entry_hi = plot(show_entry ? entry_high : na, "Entry High", color=color.new(color.teal, 80))
fill(p_entry_lo, p_entry_hi, color=color.new(color.teal, 90), title="Entry Zone")

// TP / SL lines
plot(show_tp_sl ? tp1 : na, "TP1", color=color.new(color.lime, 30), linewidth=1, style=plot.style_cross)
plot(show_tp_sl ? tp2 : na, "TP2", color=color.new(color.lime, 50), linewidth=1, style=plot.style_cross)
plot(show_tp_sl ? sl_price : na, "Stop Loss", color=color.new(color.red, 30), linewidth=1, style=plot.style_cross)

// Volume Spike markers
plotshape(rvol >= rvol_spike, "Volume Spike", shape.triangleup, location.belowbar, color.new(color.orange, 0), size=size.tiny)

// ─── BREAKOUT / BREAKDOWN DETECTION ──────────────────────────────
prev_resistance = ta.highest(high[1], sr_period)
prev_support    = ta.lowest(low[1], sr_period)

is_breakout  = close > prev_resistance and rvol > 1.2
is_breakdown = close < prev_support

plotshape(is_breakout, "Breakout", shape.labelup, location.belowbar, color.new(color.blue, 0), text="BO", textcolor=color.white, size=size.small)
plotshape(is_breakdown, "Breakdown", shape.labeldown, location.abovebar, color.new(color.maroon, 0), text="BD", textcolor=color.white, size=size.small)

// ─── TABLE: LIVE DASHBOARD ───────────────────────────────────────
var table dashboard = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "⚡ Scanner", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 30))
    table.cell(dashboard, 1, 0, "", bgcolor=color.new(color.blue, 30))
    
    table.cell(dashboard, 0, 1, "Momentum", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 1, mom_strength, text_color=mom_strength == "STRONG" ? color.lime : mom_strength == "MODERATE" ? color.orange : color.red, text_size=size.small)
    
    table.cell(dashboard, 0, 2, "Trend", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 2, trend_dir, text_color=trend_dir == "UP" ? color.lime : trend_dir == "DOWN" ? color.red : color.orange, text_size=size.small)
    
    table.cell(dashboard, 0, 3, "RSI", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 3, str.tostring(rsi14, "#.0"), text_color=rsi14 > 70 ? color.red : rsi14 < 30 ? color.green : color.white, text_size=size.small)
    
    table.cell(dashboard, 0, 4, "ADX", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 4, str.tostring(adxValue, "#.0"), text_color=adxValue > 25 ? color.lime : color.orange, text_size=size.small)
    
    table.cell(dashboard, 0, 5, "RVOL", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 5, str.tostring(rvol, "#.0x"), text_color=rvol >= 2 ? color.lime : rvol >= 1.2 ? color.orange : color.gray, text_size=size.small)
    
    table.cell(dashboard, 0, 6, "VWAP Dist", text_color=color.gray, text_size=size.small)
    vwap_dist = vwapVal > 0 ? (close - vwapVal) / vwapVal * 100 : 0
    table.cell(dashboard, 1, 6, str.tostring(vwap_dist, "+#.2") + "%", text_color=vwap_dist > 0 ? color.lime : color.red, text_size=size.small)
    
    table.cell(dashboard, 0, 7, "R/R Ratio", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 7, "1:" + str.tostring(rr_ratio, "#.1"), text_color=rr_ratio >= 2 ? color.lime : rr_ratio >= 1.5 ? color.orange : color.red, text_size=size.small)

    table.cell(dashboard, 0, 8, "TP1", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 8, str.tostring(tp1, "#.0"), text_color=color.lime, text_size=size.small)
    
    table.cell(dashboard, 0, 9, "SL", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 9, str.tostring(sl_price, "#.0"), text_color=color.red, text_size=size.small)

    table.cell(dashboard, 0, 10, "Support", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 10, str.tostring(support, "#.0"), text_color=color.green, text_size=size.small)

    table.cell(dashboard, 0, 11, "Resistance", text_color=color.gray, text_size=size.small)
    table.cell(dashboard, 1, 11, str.tostring(resistance, "#.0"), text_color=color.red, text_size=size.small)
